# <mnt_point>   <fs_type>         <src>                                                             <flags>     

/vbmeta         emmc     /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vbmeta           flags=display="vbmeta";backup=1;flashimg=1
/vbmeta_bak     emmc     /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vbmeta_bak       flags=display="vbmeta_bak"
/vbmeta_system  emmc  /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vbmeta_system       flags=display="vbmeta system";backup=1;flashimg=1
/vbmeta_vendor  emmc  /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/vbmeta_vendor       flags=display="vbmeta vendor";backup=1;flashimg=1
/misc           emmc       /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/misc           flags=display="misc"


/boot           emmc /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/boot         flags=display="Boot";backup=1;flashimg=1
/recovery       emmc /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1

/socko   ext4   /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/socko          
/odmko   ext4   /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/odmko     
/cache   ext4     /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/cache           flags=display="Cache" 
/metadata  ext4  /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/metadata         flags=display="Metadata";backup=1

# dynamic partitions
# Main Image Partitions
/system_image  emmc		/dev/block/by-name/system			flags=display="System (Image)";backup=1;flashimg=1
/vendor_image  emmc		/dev/block/by-name/vendor			flags=display="Vendor (Image)";backup=1;flashimg=1
/product_image emmc		/dev/block/by-name/product                      flags=display="Product (Image)";backup=1;flashimg=1

# Other Partitions
/system_root   ext4		/dev/block/by-name/system                    flags=display="System";backup=0;wipeingui
/vendor        ext4		/dev/block/by-name/vendor                    flags=display="Vendor";backup=0;wipeingui
/system_ext    ext4		/dev/block/by-name/system_ext                    flags=display="System Ext";backup=0;wipeingui
/product       ext4		/dev/block/by-name/product                   flags=display="Product";backup=0;wipeingui


# data
/data  f2fs  /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/userdata   flags=fileencryption=adiantum;keydirectory=/metadata/vold/metadata_encryption
/data  ext4  /dev/block/platform/soc/soc:ap-ahb/20600000.sdio/by-name/userdata   flags=fileencryption=adiantum;keydirectory=/metadata/vold/metadata_encryption

# Removable storage
/external_sd	vfat	/dev/block/mmcblk1p1	/dev/block/mmcblk1	flags=fsflags=utf8;display="MicroSD card";storage;wipeingui;removable
/usb-otg	vfat	/dev/block/sda1	/dev/block/sda	                flags=fsflags=utf8;display="USB-OTG";storage;wipeingui;removable
